<Window x:Class="Ethel_AI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ethel - Your Personal AI Assistant"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,20">

            <TextBlock Text="ETHEL"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="YOUR PERSONAL AI ASSISTANT"
                       FontSize="12"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Conversation area -->
            <Border Grid.Column="0"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock Text="Conversation"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Hello! I'm Ethel."
                               FontSize="18"
                               Foreground="#A78BFA"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Your personal assistant is ready. How can I help you today?"
                               FontSize="14"
                               Foreground="#D1D5DB"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Assistant controls -->
            <Border Grid.Column="1"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="20">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Assistant Status"
                               FontSize="18"
                               Foreground="White"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="StatusText"
                                Text="● Idle"
                                FontSize="15"
                                Foreground="#34D399"
                                HorizontalAlignment="Center"
                                Margin="0,15,0,30"/>


                    <Button x:Name="MicrophoneButton"
                            Content="🎙"
                            Width="190"
                            Height="65"
                            FontSize="40"
                            Background="#7C3AED"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Click="MicrophoneButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                    CornerRadius="35">

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>


                    <!-- Sound wave animation -->
                    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Height="55"
            Margin="0,15,0,0">

                        <Rectangle x:Name="Wave1" Width="6" Height="35"
               Margin="4" RadiusX="3" RadiusY="3"
               Fill="#A78BFA"
               RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Rectangle x:Name="Wave2" Width="6" Height="45"
               Margin="4" RadiusX="3" RadiusY="3"
               Fill="#A78BFA"
               RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Rectangle x:Name="Wave3" Width="6" Height="30"
               Margin="4" RadiusX="3" RadiusY="3"
               Fill="#C4B5FD"
               RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Rectangle x:Name="Wave4" Width="6" Height="50"
               Margin="4" RadiusX="3" RadiusY="3"
               Fill="#A78BFA"
               RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Rectangle x:Name="Wave5" Width="6" Height="30"
               Margin="4" RadiusX="3" RadiusY="3"
               Fill="#C4B5FD"
               RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Rectangle x:Name="Wave6" Width="6" Height="45"
               Margin="4" RadiusX="3" RadiusY="3"
               Fill="#A78BFA"
               RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Rectangle x:Name="Wave7" Width="6" Height="35"
               Margin="4" RadiusX="3" RadiusY="3"
               Fill="#A78BFA"
               RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                    </StackPanel>



                    <TextBlock Text="Tap to speak"
                               Foreground="#D1D5DB"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"/>
                    

                    <Button Content="Settings"
                            Height="40"
                            Margin="0,35,0,0"
                            Background="#374151"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="Ethel AI • Windows 11 Assistant"
                   Foreground="#6B7280"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>

    </Grid>
</Window>
